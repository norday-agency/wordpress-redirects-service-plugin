{
  "name": "grrr-amsterdam/wordpress-redirects-service-plugin",
  "description": "Manage redirects for the GRRR redirects service via WordPress",
  "type": "wordpress-plugin",
  "license": "BSD-3-Clause",
  "autoload": {
    "psr-4": {
      "Grrr\\Redirects\\WordPress\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Ramiro Hammen",
      "email": "ramiro@grrr.nl"
    }
  ],
  "require": {
    "composer/installers": "^2.2",
    "phpoffice/phpspreadsheet": "^1.29",
    "wp-cli/wp-cli-bundle": "^2.8"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "require-dev": {
    "johnpbloch/wordpress-core": "^6.2",
    "phpstan/phpstan": "^1.10",
    "szepeviktor/phpstan-wordpress": "^1.3"
  },
  "scripts": {
    "static-analysis": "phpstan analyse --ansi --memory-limit 512M"
  }
}
