  "description": "Manage redirects for the GRRR redirects service via WordPress",
  "type": "wordpress-plugin",
  "autoload": {
    "psr-4": {
      "Grrr\\Redirects\\WordPress\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Ramiro Hammen",
      "email": "ramiro@grrr.nl"
    }
  ],
  "require": {
    "composer/installers": "^2.2"
